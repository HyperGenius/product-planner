{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pytest selected file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v", "--run-e2e"],
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env",
            "console": "integratedTerminal"
        }
    ]
}