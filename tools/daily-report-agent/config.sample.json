{
  "api_base_url": "https://<project-ref>.supabase.co/functions/v1/agent-gateway",
  "token": "<issue_agent_token.py issue で発行したトークン>",
  "targets": [
    {
      "kind": "daily_reports",
      "folders": [
        "\\\\fileserver.example.local\\share\\日報"
      ]
    },
    {
      "kind": "shipment_files",
      "folders": [
        "\\\\fileserver.example.local\\share\\弥生取り込み"
      ]
    }
  ],
  "recurse": true,
  "state_path": "state\\sent-files.json",
  "log_dir": "logs",
  "log_retention_days": 30,
  "max_file_bytes": 20971520,
  "timeout_seconds": 120
}
